ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm-7.2.0/bin/hipcc

cflags = -D_GLIBCXX_USE_CXX11_ABI=1 -DTORCH_EXTENSION_NAME=module_smoothquant -I/sgl-workspace/aiter/aiter_meta/3rdparty/ck_helper -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/include -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/library/include -I/sgl-workspace/aiter/aiter_meta/csrc/include -I/sgl-workspace/aiter/aiter/jit/build/module_smoothquant/blob -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/example/ck_tile/12_smoothquant -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/example/ck_tile/14_moe_smoothquant -I/sgl-workspace/aiter/aiter_meta/csrc/include/torch -I/opt/venv/lib/python3.10/site-packages/pybind11/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/THH -isystem /opt/venv/lib/python3.10/site-packages/torch/include/THC -isystem /opt/rocm-7.2.0/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/TH -isystem /usr/include/python3.10 -fPIC -std=c++20 -O3 -std=c++20 -Wno-unknown-warning-option -DENABLE_CK=1 -DPREBUILD_KERNELS=1
post_cflags = -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2
cuda_cflags = -DWITH_HIP -D_GLIBCXX_USE_CXX11_ABI=1 -DTORCH_EXTENSION_NAME=module_smoothquant -I/sgl-workspace/aiter/aiter_meta/3rdparty/ck_helper -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/include -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/library/include -I/sgl-workspace/aiter/aiter_meta/csrc/include -I/sgl-workspace/aiter/aiter/jit/build/module_smoothquant/blob -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/example/ck_tile/12_smoothquant -I/sgl-workspace/aiter/aiter_meta/3rdparty/composable_kernel/example/ck_tile/14_moe_smoothquant -I/sgl-workspace/aiter/aiter_meta/csrc/include/torch -I/opt/venv/lib/python3.10/site-packages/pybind11/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/THH -isystem /opt/venv/lib/python3.10/site-packages/torch/include/THC -isystem /opt/rocm-7.2.0/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include -isystem /opt/venv/lib/python3.10/site-packages/torch/include/TH -isystem /usr/include/python3.10 -fPIC -std=c++20 -O3 -std=c++20 -Wno-unknown-warning-option -DENABLE_CK=1 -DPREBUILD_KERNELS=1 -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -mcmodel=large -fno-unique-section-names -ffunction-sections -fdata-sections -fvisibility=hidden -fvisibility-inlines-hidden --offload-arch=gfx942 -DDLLVM_MAIN_REVISION=554785 -DLEGACY_HIPBLAS_DIRECT -DPREBUILD_KERNELS=1 -DTORCH_Float4_e2m1fn_x2 -DUSE_PROF_API=1 -D__HIP_PLATFORM_AMD__=1 -D__HIP_PLATFORM_HCC__=1 -U__HIP_NO_HALF_CONVERSIONS__ -U__HIP_NO_HALF_OPERATORS__ -Wno-macro-redefined -Wno-missing-template-arg-list-after-template-kw -Wno-switch-bool -Wno-undefined-func-template -Wno-unused-result -Wno-vla-cxx-extension -fgpu-flush-denormals-to-zero -fno-offload-uniform-block -mllvm --amdgpu-kernarg-preload-count=16 -mllvm --lsr-drop-solution=1 -mllvm -amdgpu-early-inline-all=true -mllvm -amdgpu-function-calls=false -mllvm -enable-post-misched=0 -fno-gpu-rdc
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -mcmodel=large -ffunction-sections -fdata-sections -Wl,--gc-sections -Wl,--cref -L/opt/venv/lib/python3.10/site-packages/torch/lib -lc10 -lc10_hip -ltorch_cpu -ltorch_hip -ltorch -ltorch_python -L/opt/rocm-7.2.0/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx @$out.rsp $ldflags -o $out
  rspfile = $out.rsp
  rspfile_content = $in

